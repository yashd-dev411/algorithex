# The app requires this directory to exist and to contain `strategies/` and
# `storage/`; it refuses to start otherwise (helpers.is_algorithex_project).
#
# Everything the app generates at runtime is ignored, so the skeleton stays
# tracked and your actual strategies stay under your own control.

# Runtime data
storage/*.key
storage/*.sqlite
storage/*.sqlite-journal
storage/*.db
storage/*.gz
storage/*.zip
storage/temp/
storage/logs/*.log
storage/logs/collect.txt
storage/logs/trades/
storage/orders/
storage/charts/
storage/candles/
storage/backtest-charts/
storage/significance-test-charts/
storage/optimization-charts/

# Credentials, if you add any
.env
*.key
*.pem

# Editor noise
.DS_Store
*.swp
__pycache__/
*.pyc
