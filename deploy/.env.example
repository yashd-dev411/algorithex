# Copy to `.env` and edit. `.env` is gitignored; this template is tracked so the
# variables are discoverable without reading the compose file.
#
#     cp .env.example .env
#
# Every value below is a local default. Compose falls back to the same defaults
# if a variable is unset, so an empty `.env` still runs -- which is exactly what
# you do not want on a machine anyone else can reach.

# --- Dashboard password -------------------------------------------------
# The password you type into the web UI. Its sha256 is what the API compares,
# so changing it invalidates existing sessions.
# CHANGE THIS before exposing the dashboard beyond localhost.
PASSWORD=test

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_NAME=algorithex_db
POSTGRES_USERNAME=algorithex_user
# CHANGE THIS if the database is reachable from anywhere but this machine.
POSTGRES_PASSWORD=password

# --- Redis --------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Host ports ---------------------------------------------------------
APP_PORT=9000
LSP_PORT=9001
MCP_PORT=9002
JUPYTER_PORT=8888

# --- Image --------------------------------------------------------------
# Leave as-is to build from source. Point at a published image to deploy
# without a build context:
#   ALGORITHEX_IMAGE=ghcr.io/<owner>/<repo>:latest
ALGORITHEX_IMAGE=algorithex:latest

# --- Optional -----------------------------------------------------------
LICENSE_API_TOKEN=
MCP_USAGE_METER=local
MCP_GUEST_DAILY_CREDITS=100000
MCP_FREE_DAILY_CREDITS=100000
MCP_LOG_IN_TERMINAL=true
